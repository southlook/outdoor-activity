<view class="activity-card" bind:tap="onTap">
  <!-- 封面图 -->
  <view class="card-cover">
    <image class="cover-image" src="{{coverSrc}}" mode="aspectFill" lazy-load binderror="onCoverError"></image>
    <!-- 状态标签 -->
    <view class="status-tag tag-{{statusInfo.type}}">
      <text>{{statusInfo.text}}</text>
    </view>
    <!-- 分类标签 -->
    <view class="category-tag">
      <text>{{categoryName}}</text>
    </view>
    <!-- 删除按钮 -->
    <view class="delete-btn" wx:if="{{showDelete}}" catch:tap="onDelete">
      <text>删除</text>
    </view>
  </view>

  <!-- 信息区 -->
  <view class="card-info">
    <text class="card-title text-ellipsis-2">{{activity.title}}</text>

    <view class="card-meta">
      <view class="meta-item">
        <text class="meta-icon">📅</text>
        <text class="meta-text">{{timeText}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-icon">📍</text>
        <text class="meta-text text-ellipsis">{{activity.location.name}}</text>
      </view>
    </view>

    <view class="card-bottom">
      <view class="price-area">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{activity.fee}}</text>
        <text class="price-unit">/人</text>
      </view>
      <view class="participants-area">
        <text class="participants-text">{{activity.currentParticipants}}/{{activity.maxParticipants}}人</text>
      </view>
    </view>
  </view>
</view>
