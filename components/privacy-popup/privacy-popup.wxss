.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-dialog {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 28rpx;
}

.dialog-content {
  font-size: 26rpx;
  line-height: 1.7;
  color: #666666;
  margin-bottom: 40rpx;
}

.dialog-link {
  color: #2db84b;
}

.dialog-btns {
  display: flex;
}

.btn-disagree,
.btn-agree {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  margin: 0;
  padding: 0;
}

.btn-disagree {
  background: #f5f6f8;
  color: #666666;
  margin-right: 20rpx;
}

.btn-agree {
  background: #2db84b;
  color: #ffffff;
}

.btn-disagree::after,
.btn-agree::after {
  border: none;
}
