.load-more {
  padding: 32rpx 0 48rpx;
}

.load-more-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

.text-weak {
  color: #ccc;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #eee;
  border-top-color: #2DB84B;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-more-line {
  width: 80rpx;
  height: 1rpx;
  background: #eee;
  margin: 0 20rpx;
}
