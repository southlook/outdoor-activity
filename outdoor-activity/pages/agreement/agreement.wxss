@import '../../styles/variables.wxss';

.page-agreement {
  min-height: 100vh;
  background: var(--color-bg-white);
  padding: 40rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.agreement-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 12rpx;
}

.agreement-update {
  font-size: 24rpx;
  color: var(--color-text-weak);
  text-align: center;
  margin-bottom: 48rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.section-paragraph {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  text-align: justify;
}
