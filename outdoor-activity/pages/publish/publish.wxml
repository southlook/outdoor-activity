<view class="page-publish">
  <!-- 官方隐私授权弹窗 -->
  <privacy-popup />

  <!-- 基本信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">基本信息</text>
    </view>

    <view class="form-group">
      <text class="form-label">活动标题<text class="required">*</text></text>
      <input class="form-input" placeholder="请输入活动标题，如：武功山三日徒步" value="{{form.title}}" bindinput="onInput" data-field="title" maxlength="50" />
      <text class="char-count">{{form.title.length}}/50</text>
    </view>

    <view class="form-group">
      <text class="form-label">活动分类<text class="required">*</text></text>
      <view class="category-grid">
        <view
          class="category-option {{form.category === item.id ? 'selected' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bind:tap="onSelectCategory"
          data-id="{{item.id}}"
        >
          <text class="cat-icon">{{item.icon}}</text>
          <text class="cat-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 时间设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">时间安排</text>
    </view>

    <view class="form-group">
      <text class="form-label">出发时间<text class="required">*</text></text>
      <picker mode="date" value="{{form.startDate}}" start="{{today}}" bindchange="onStartDateChange">
        <view class="picker-row">
          <text class="picker-icon">📅</text>
          <text class="{{form.startDate ? 'picker-value' : 'picker-placeholder'}}">
            {{form.startDate || '选择出发日期'}}
          </text>
          <picker mode="time" value="{{form.startTime}}" bindchange="onStartTimeChange" wx:if="{{form.startDate}}">
            <text class="picker-time">{{form.startTime || '选择时间'}}</text>
          </picker>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">结束时间<text class="required">*</text></text>
      <picker mode="date" value="{{form.endDate}}" start="{{form.startDate || today}}" bindchange="onEndDateChange">
        <view class="picker-row">
          <text class="picker-icon">📅</text>
          <text class="{{form.endDate ? 'picker-value' : 'picker-placeholder'}}">
            {{form.endDate || '选择结束日期'}}
          </text>
          <picker mode="time" value="{{form.endTime}}" bindchange="onEndTimeChange" wx:if="{{form.endDate}}">
            <text class="picker-time">{{form.endTime || '选择时间'}}</text>
          </picker>
        </view>
      </picker>
    </view>
  </view>

  <!-- 地点设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">活动地点</text>
    </view>

    <view class="form-group">
      <text class="form-label">地点名称<text class="required">*</text></text>
      <input class="form-input" placeholder="如：江西萍乡·武功山" value="{{form.locationName}}" bindinput="onInput" data-field="locationName" />
    </view>

    <view class="form-group">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="详细地址（选填）" value="{{form.locationAddress}}" bindinput="onInput" data-field="locationAddress" />
    </view>
  </view>

  <!-- 费用与人数 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">费用与人数</text>
    </view>

    <view class="form-row">
      <view class="form-group form-half">
        <text class="form-label">费用(元)<text class="required">*</text></text>
        <input class="form-input" type="digit" placeholder="0" value="{{form.fee}}" bindinput="onInput" data-field="fee" />
      </view>
      <view class="form-group form-half">
        <text class="form-label">人数上限<text class="required">*</text></text>
        <input class="form-input" type="number" placeholder="30" value="{{form.maxParticipants}}" bindinput="onInput" data-field="maxParticipants" />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">费用说明</text>
      <input class="form-input" placeholder="如：含交通、住宿、保险等" value="{{form.feeDescription}}" bindinput="onInput" data-field="feeDescription" />
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">活动图片</text>
      <text class="section-hint">最多9张</text>
    </view>

    <view class="image-grid">
      <view class="image-item" wx:for="{{imageList}}" wx:key="index">
        <image class="preview-image" src="{{item}}" mode="aspectFill" bind:tap="previewImage" data-index="{{index}}" />
        <view class="image-delete" catch:tap="onDeleteImage" data-index="{{index}}">✕</view>
      </view>
      <view class="image-add" wx:if="{{imageList.length < 9}}" bind:tap="onChooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 活动群二维码 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">活动微信群二维码</text>
      <text class="section-hint">选填，报名成功后展示给用户</text>
    </view>
    <view class="qr-upload-row">
      <view class="image-item qr-item" wx:if="{{groupQrCode}}">
        <image class="preview-image" src="{{groupQrCode}}" mode="aspectFit" bind:tap="previewGroupQr" />
        <view class="image-delete" catch:tap="onDeleteGroupQr">✕</view>
      </view>
      <view class="image-add qr-add" wx:else bind:tap="onChooseGroupQr">
        <text class="add-icon">+</text>
        <text class="add-text">上传二维码</text>
      </view>
      <view class="qr-tip">
        <text>• 建议上传微信群二维码图片，报名成功后自动展示</text>
      </view>
      <view class="qr-tip">
        <text>• 微信群二维码有效期 7 天，过期请更新</text>
      </view>
    </view>
  </view>

  <!-- 活动详情 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">活动详情</text>
    </view>

    <view class="form-group">
      <text class="form-label">活动介绍<text class="required">*</text></text>
      <textarea class="form-textarea desc-textarea" placeholder="请详细描述活动内容、亮点和特色..." value="{{form.description}}" bindinput="onInput" data-field="description" maxlength="2000" />
      <text class="char-count">{{form.description.length}}/2000</text>
    </view>

    <view class="form-group">
      <text class="form-label">行程安排</text>
      <textarea class="form-textarea" placeholder="请按天描述行程安排，如：&#10;Day1：集合出发 - 到达营地&#10;Day2：..." value="{{form.itinerary}}" bindinput="onInput" data-field="itinerary" maxlength="2000" />
    </view>

    <view class="form-group">
      <text class="form-label">注意事项</text>
      <textarea class="form-textarea" placeholder="请列出参与者需要注意的事项..." value="{{form.notices}}" bindinput="onInput" data-field="notices" maxlength="1000" />
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部发布按钮 -->
  <view class="bottom-bar safe-bottom">
    <button class="btn btn-primary btn-block btn-publish" bind:tap="onPublish" disabled="{{publishing}}">
      {{publishing ? '发布中...' : '发布活动'}}
    </button>
  </view>
</view>
