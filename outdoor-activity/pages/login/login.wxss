@import '../../styles/variables.wxss';

.page-login {
  min-height: 100vh;
  background: var(--color-bg-white);
  display: flex;
  flex-direction: column;
  padding: 0 60rpx;
}

/* Logo */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: var(--color-text-weak);
}

/* 头像区域 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}

.avatar-btn {
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-bg);
  margin-bottom: 16rpx;
}

.avatar-tip {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 昵称输入 */
.login-form {
  margin-bottom: 60rpx;
}

.nickname-input {
  text-align: center;
  font-size: 32rpx;
}

/* 登录按钮 */
.login-actions {
  margin-bottom: 48rpx;
}

.btn-login {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
  margin-bottom: 32rpx;
}

.skip-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-weak);
}

/* 协议：默认不勾选，用户主动选择 */
.agreement {
  display: flex;
  align-items: flex-start;
  padding-bottom: 60rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--color-text-weak);
  border-radius: 50%;
  margin-right: 12rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox-checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox-icon {
  color: var(--color-text-white);
  font-size: 20rpx;
  line-height: 1;
}

.agreement-content {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.agreement-text {
  font-size: 22rpx;
  line-height: 40rpx;
  color: var(--color-text-weak);
}

.agreement-link {
  font-size: 22rpx;
  line-height: 40rpx;
  color: var(--color-primary);
}
