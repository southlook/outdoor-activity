.activity-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.card-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.status-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-green {
  background: rgba(45, 184, 75, 0.9);
  color: #fff;
}

.tag-red {
  background: rgba(231, 76, 60, 0.9);
  color: #fff;
}

.tag-gray {
  background: rgba(153, 153, 153, 0.8);
  color: #fff;
}

.category-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
}

.delete-btn {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(231, 76, 60, 0.9);
  color: #fff;
}

.card-info {
  padding: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 580rpx;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-area {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
}

.price-value {
  font-size: 40rpx;
  color: #FF6B35;
  font-weight: 700;
  line-height: 1;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.participants-text {
  font-size: 24rpx;
  color: #999;
}
