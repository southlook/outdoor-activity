@import '../../styles/variables.wxss';

.page-publish {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 20rpx;
}

/* 区块 */
.section {
  background: var(--color-bg-white);
  margin-bottom: 16rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-hint {
  font-size: 24rpx;
  color: var(--color-text-weak);
}

/* 字数统计 */
.char-count {
  font-size: 22rpx;
  color: var(--color-text-weak);
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 120rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.category-option.selected {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.cat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.category-option.selected .cat-name {
  color: var(--color-primary);
  font-weight: 600;
}

/* 时间选择器 */
.picker-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 0 24rpx;
}

.picker-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.picker-placeholder {
  font-size: 28rpx;
  color: var(--color-text-weak);
}

.picker-time {
  font-size: 28rpx;
  color: var(--color-primary);
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid var(--color-border);
}

/* 双列表单 */
.form-row {
  display: flex;
  gap: 24rpx;
}

.form-half {
  flex: 1;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 22rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: var(--color-bg);
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.add-icon {
  font-size: 56rpx;
  color: #ccc;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: var(--color-text-weak);
  margin-top: 8rpx;
}

/* 群二维码上传区 */
.qr-upload-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.qr-item {
  width: 240rpx;
  height: 240rpx;
}

.qr-add {
  width: 240rpx;
  height: 240rpx;
}

.qr-tip {
  font-size: 22rpx;
  color: var(--color-text-weak);
  line-height: 1.5;
}

/* 详情文本域 */
.desc-textarea {
  min-height: 300rpx;
}

/* 发布按钮 */
.btn-publish {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 34rpx;
}
