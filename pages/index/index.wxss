@import '../../styles/variables.wxss';

.page-index {
  min-height: 100vh;
  background: var(--color-bg);
  overflow-x: hidden;
}

/* 搜索栏 */
.search-bar {
  background: var(--color-primary);
  padding: 16rpx 24rpx 24rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-primary);
  height: 72rpx;
}

.search-placeholder {
  color: var(--color-text-weak);
  font-size: 26rpx;
}

.search-clear {
  font-size: 28rpx;
  color: var(--color-text-weak);
  padding: 8rpx;
}

/* 分类筛选 */
.category-scroll {
  background: var(--color-bg-white);
  white-space: nowrap;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  padding: 12rpx 0;
  position: relative;
}

.category-item.active .category-name {
  color: var(--color-primary);
  font-weight: 600;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.category-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 活动列表 */
.activity-list {
  padding: 24rpx;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
