<view class="page-user-center">
  <!-- 官方隐私授权弹窗 -->
  <privacy-popup />

  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-info" bind:tap="goLogin">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/placeholders/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-detail" wx:if="{{isLogin}}">
        <text class="user-name">{{userInfo.nickName}}</text>
        <text class="user-id">ID: {{openid}}</text>
      </view>
      <view class="user-detail" wx:else>
        <text class="user-name login-hint">点击登录</text>
        <text class="user-slogan">登录后享受更多功能</text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-row" wx:if="{{isLogin}}">
    <view class="stat-item" bind:tap="goMyActivities" wx:if="{{isAdmin}}">
      <text class="stat-value">{{stats.published}}</text>
      <text class="stat-label">已发布</text>
    </view>
    <view class="stat-divider" wx:if="{{isAdmin}}"></view>
    <view class="stat-item" bind:tap="goMySignups">
      <text class="stat-value">{{stats.signups}}</text>
      <text class="stat-label">已报名</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.favorites}}</text>
      <text class="stat-label">收藏</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bind:tap="goPublish" wx:if="{{isAdmin}}">
      <text class="menu-icon">✍️</text>
      <text class="menu-text">发布活动</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="goMyActivities">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我发布的活动</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="goMySignups">
      <text class="menu-icon">🎫</text>
      <text class="menu-text">我报名的活动</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="goFavorites">
      <text class="menu-icon">❤️</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bind:tap="onFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="goUserAgreement">
      <text class="menu-icon">📄</text>
      <text class="menu-text">用户服务协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="goPrivacyPolicy">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="btn btn-outline btn-block btn-logout" bind:tap="onLogout">退出登录</button>
  </view>
</view>
